<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocusStage</AssemblyName>
    <RootNamespace>FocusStageTray</RootNamespace>
    <Version>0.1.2</Version>
    <Product>FocusStage</Product>
    <Authors>Charlie929-dot</Authors>
    <Description>Windows 11 launcher, tray, and native Direct2D window host for FocusStage WSL2 Wayland compositor</Description>
    <Copyright>Copyright (c) 2026 Charlie929-dot</Copyright>
    <RepositoryUrl>https://github.com/Charlie929-dot/FocusStage</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="webui\**\*.*" LogicalName="FocusStageTray.webui.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
